{
  "name": "dsh-theme-palette",
  "version": "1.4.0",
  "description": "DSH 主题配色：4 套配色 × 明暗两模式，OKLCH 色域安全重建 + 真实承载面对比度求解，可调强度与面板表面。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "palette-dev.mjs",
    "tools/sheet.mjs",
    "tools/shoot-sheet.mjs",
    "tools/shoot-html.mjs",
    "tools/preview-settings.mjs",
    "tools/shoot-desktop.mjs",
    "tools/compare.mjs",
    "tools/release.mjs",
    "CHANGELOG.md",
    "docs/DESIGN.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "palette",
    "oklch",
    "dark-mode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuoyunlai/dsh-theme-palette.git"
  },
  "homepage": "https://github.com/zuoyunlai/dsh-theme-palette#readme",
  "bugs": {
    "url": "https://github.com/zuoyunlai/dsh-theme-palette/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
